# Test environment overrides — loaded by vitest via dotenv.
# Same Postgres container, separate database for isolation.
NODE_ENV=test
API_PORT=3099
API_HOST=127.0.0.1
LOG_LEVEL=error

DATABASE_URL=postgresql://medivault:medivault@localhost:5433/medivault_test?schema=public

JWT_ACCESS_SECRET=test-access-secret-must-be-at-least-32-chars
JWT_REFRESH_SECRET=test-refresh-secret-must-be-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=4

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=mock

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=medivault-test
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_PUT_TTL=600
S3_PRESIGNED_GET_TTL=900

# AI: tests never call real providers. The provider is mocked in setup.ts.
AI_PROVIDER=gemini
GEMINI_API_KEY=test-not-used
ANTHROPIC_API_KEY=
BEDROCK_REGION=us-east-1
AI_MODEL_EXTRACTION=gemini-2.5-flash
AI_MODEL_SUMMARY=gemini-2.5-pro
AI_MODEL_QA=gemini-2.5-flash
AI_MODEL_CLASSIFY=gemini-2.5-flash-lite
AI_RATE_LIMIT_PER_PATIENT_PER_DOCTOR_PER_DAY=100

REDIS_URL=redis://localhost:6380

# Don't start the BullMQ worker in tests — extraction is mocked at the service level.
RUN_EXTRACTION_WORKER=false
