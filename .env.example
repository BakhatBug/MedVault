# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=debug

# ─── Database (Postgres via docker compose) ────────────────────────────────────
DATABASE_URL=postgresql://medivault:medivault@localhost:5433/medivault?schema=public

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ─── OTP / SMS (provider TBD: Twilio or AWS SNS) ───────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── AWS / S3 (MinIO locally — leave S3_ENDPOINT empty to use real AWS S3) ─────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=medivault
AWS_SECRET_ACCESS_KEY=medivault-dev
S3_BUCKET=medivault-records-dev
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_PUT_TTL=600
S3_PRESIGNED_GET_TTL=900

# ─── AI Provider ───────────────────────────────────────────────────────────────
# "gemini"    → direct Google AI API (default for non-HIPAA tenants)
# "anthropic" → direct Claude API (alternative)
# "bedrock"   → AWS Bedrock Claude (HIPAA tenants — BAA-eligible, stub)
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
BEDROCK_REGION=us-east-1

# Models — Gemini defaults. If switching to anthropic, set to claude-* equivalents
# (see docs/adr/0003-ai-provider-abstraction.md for the mapping table).
AI_MODEL_EXTRACTION=gemini-2.5-flash
AI_MODEL_SUMMARY=gemini-2.5-pro
AI_MODEL_QA=gemini-2.5-flash
AI_MODEL_CLASSIFY=gemini-2.5-flash-lite

# Cost guard — per spec §8.6
AI_RATE_LIMIT_PER_PATIENT_PER_DOCTOR_PER_DAY=10

# ─── Redis (queue + cache) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Push notifications (FCM) ──────────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON=
